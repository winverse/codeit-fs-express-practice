{
  "name": "codeit-fs-express-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/problems.test.js",
    "test:answers": "node --test test/answers.test.js",
    "check:01": "PRACTICE_UNIT=01 node --test --test-name-pattern='^01 ' test/problems.test.js",
    "check:02": "PRACTICE_UNIT=02 node --test --test-name-pattern='^02 ' test/problems.test.js",
    "check:03": "PRACTICE_UNIT=03 node --test --test-name-pattern='^03 ' test/problems.test.js",
    "check:04": "PRACTICE_UNIT=04 node --test --test-name-pattern='^04 ' test/problems.test.js",
    "check:05": "PRACTICE_UNIT=05 node --test --test-name-pattern='^05 ' test/problems.test.js",
    "check:06": "PRACTICE_UNIT=06 node --test --test-name-pattern='^06 ' test/problems.test.js",
    "check:07": "PRACTICE_UNIT=07 node --test --test-name-pattern='^07 ' test/problems.test.js",
    "check:08": "PRACTICE_UNIT=08 node --test --test-name-pattern='^08 ' test/problems.test.js",
    "check:09": "PRACTICE_UNIT=09 node --test --test-name-pattern='^09 ' test/problems.test.js",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "3.9.6",
    "supertest": "^7.2.2"
  }
}
